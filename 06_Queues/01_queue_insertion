#include <stdio.h>

#define MAX 5
int queue_arr[MAX];
int front = -1;
int rear = -1;

void insert(int data){
    if(rear == MAX-1){
        printf("Stack is Overflow !!");
    }
    else if(front==-1 && rear == -1){
        front++;
        rear++;
        queue_arr[rear] = data;
    }
    else{
        rear++;
        queue_arr[rear] = data;
    }
}

int main(){
    insert(5); 
    insert(10); 
    insert(15); 
    insert(20); 
    insert(25); 
    insert(30); 
    return 0;
}
