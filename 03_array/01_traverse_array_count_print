#include <stdio.h>

/*Time complexity
count_ele :arr(O(1)) ,LL{O(n)}
print_data : arr{O(n)}, LL{O(n)}
*/

int main(){
    
    int arr[]={2,3,5};
    int count;
    count = sizeof(arr)/sizeof(int);
    printf("no. of element is %d\n",count);

    for (int i = 0; i < count; i++)
    {
        printf("%d ",arr[i]);
    }

    return 0 ;
}
